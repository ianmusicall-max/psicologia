# Credenciales. Nunca.
.env
.env.*

# Entorno de Python: se reconstruye con requirements.txt.
.venv/
__pycache__/
*.pyc

# Estado y flyers generados. Viven donde corre el sistema, no en el repo.
# Dice `data/*` y no `data/` para que la excepción de abajo valga: git no
# entra en un directorio excluido (lección del repo de salud, 2026-10-15).
data/*
!data/.gitkeep
# Lo publicado SI se versiona, y no es un descuido: el turno automatico corre
# en una maquina nueva cada hora, asi que si este archivo no viaja con el
# repo, cada corrida creeria que no salio nada y volveria a publicar la
# primera frase. El propio turno lo vuelve a subir despues de publicar.
!data/publicadas.json
# Lo que tardo la voz en cada reel. Se versiona por lo mismo: cada corrida es
# una maquina nueva, asi que sin esto la serie se pierde y `VOZ_MAS_LENTA`
# vuelve a depender de una sola medicion, que es como se llego al 1,75.
!data/factor_voz.jsonl
!data/clips_usados.json
# Los clips de fondo de los reels, si se quieren usar desde GitHub: alla la
# maquina es nueva y no tiene nada. Son unos megas cada uno y no cambian, asi
# que versionarlos cuesta poco y es lo unico que hace que el reel de GitHub
# salga sobre paisajes y no sobre el papel.
!data/fondos/
!data/fondos/*
# Menos los originales. Son la copia pesada que el usuario guarda para
# YouTube; al repositorio van las de trabajo, que es lo unico que el reel usa.
data/fondos/originales/
# El ultimo reel armado, para poder mirarlo sin bajarlo de la pestania
# Actions. Es UN archivo que se pisa a si mismo y no una carpeta entera: un
# mp4 por cada reel que se arme dejaria el repositorio inmanejable.
!data/reels/
!data/reels/ultimo.mp4
# Y su ficha: de un archivo que siempre se llama igual no se puede
# saber de que frase es, y sin eso no hay como subirlo a YouTube.
!data/reels/ultimo.youtube.json

.DS_Store

psicologia.bundle
data/muestra/
