# Credenciales. Nunca.
.env
.env.*

# Entorno de Python: se reconstruye con requirements.txt.
.venv/
__pycache__/
*.pyc

# Estado y flyers generados. Viven donde corre el sistema, no en el repo.
# Dice `data/*` y no `data/` para que la excepción de abajo valga: git no
# entra en un directorio excluido (lección del repo de salud, 2026-10-15).
data/*
!data/.gitkeep
# Lo publicado SI se versiona, y no es un descuido: el turno automatico corre
# en una maquina nueva cada hora, asi que si este archivo no viaja con el
# repo, cada corrida creeria que no salio nada y volveria a publicar la
# primera frase. El propio turno lo vuelve a subir despues de publicar.
!data/publicadas.json
# Los clips de fondo de los reels, si se quieren usar desde GitHub: alla la
# maquina es nueva y no tiene nada. Son unos megas cada uno y no cambian, asi
# que versionarlos cuesta poco y es lo unico que hace que el reel de GitHub
# salga sobre paisajes y no sobre el papel.
!data/fondos/
!data/fondos/*

.DS_Store

psicologia.bundle
data/muestra/
